[Unit]
Description=Virtual Scrum Team signed dispatch-owner relay
After=local-fs.target vst-supervisor.service
Requires=vst-supervisor.service
RequiresMountsFor=/etc/vst-runner /opt/vst-runtime
ConditionPathExists=!/etc/vst-runner/dispatch-owner-admission-blocked.json

[Service]
Type=simple
User=vst-dispatch-owner
Group=vst-dispatch-owner
SupplementaryGroups=vst-supervisor-client
ExecStart=/usr/bin/python3.12 -I -S -c "import sys; sys.path.insert(0, '/opt/vst-runtime'); from tools.vst.dispatch_owner_service import main; main()"
ExecStopPost=+/usr/bin/python3.12 -I -S -c "import sys; sys.path.insert(0, '/opt/vst-runtime'); from tools.vst.dispatch_owner_latch import main; main()"
Restart=no
TimeoutStartSec=15s
# ExecStopPost must not be killed while it is confirming socket shutdown or persisting the
# admission latch; availability yields to the ambiguous-outcome safety fence.
TimeoutStopSec=infinity
LimitNOFILE=64
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077

