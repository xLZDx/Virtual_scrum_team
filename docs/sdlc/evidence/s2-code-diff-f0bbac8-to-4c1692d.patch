+def _posix_runner_os(monkeypatch):
+    posix_os = SimpleNamespace(**vars(os))
+    posix_os.name = "posix"
+    monkeypatch.setattr(runner, "os", posix_os)
+    monkeypatch.setattr(runner, "_POSIX_CGROUP_CLEANUP_FAILED", threading.Event())
