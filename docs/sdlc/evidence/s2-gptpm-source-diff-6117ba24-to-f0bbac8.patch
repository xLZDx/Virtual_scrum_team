+def _install_mock_windows_run(monkeypatch, *, failure=None):
+    events = []
+    command_callbacks = []
+    jobs = []
+    monkeypatch.setattr(runner, "os", SimpleNamespace(name="nt"))
+
+    def popen(argv, **kwargs):
