+            "supervisor_push": pushed,
+            "supervisor_pull_request": pr,
+        }
+        report["restart_idempotency"] = {
+            "effect_recorded_before_store_commit": crash_result,
+            "retry_result_after_store_restart": retried,
+            "same_result": crash_result == retried,
