+def _inactive_systemd_outputs(units):
+    outputs = {}
+    for unit in units:
+        properties = (_socket_unit_properties() if unit.endswith(".socket")
+                      else _service_unit_properties())
+        outputs[unit] = _named_systemd_output(properties, list(reversed(properties)))
+    return outputs
